@page "/bookings"

<h3>Bookings</h3>

<div class="mb-3">
    <a class="btn btn-primary" href="/bookings/create">Create New Booking</a>
</div>

@if (bookings == null)
{
    <p><em>Loading...</em></p>
}
else if (!bookings.Any())
{
    <p>No bookings found.</p>
}
else
{
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>ID</th>
                <th>Customer ID</th>
                <th>Workstation ID</th>
                <th>Start Date</th>
                <th>End Date</th>
                <th>Notes</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var booking in bookings)
            {
                <tr>
                    <td>@booking.Id</td>
                    <td>@booking.Customer.Id</td>
                    <td>@booking.Workstation.Id</td>
                    <td>@booking.DateStart?.ToString("g")</td>
                    <td>@booking.DateEnd?.ToString("g")</td>
                    <td>@booking.Notes</td>
                    <td>
                        <a class="btn btn-sm btn-warning" href="/bookings/edit/@booking.Id">Edit</a>
                        <button class="btn btn-sm btn-danger" @onclick="() => DeleteBooking(booking.Id)">Delete</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}