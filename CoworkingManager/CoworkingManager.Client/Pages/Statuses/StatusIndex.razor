@page "/statuses"

<h3>Statuses</h3>

<div class="mb-3">
    <a class="btn btn-primary" href="/statuses/create">Create New Status</a>
</div>

@if (statuses == null)
{
    <p><em>Loading...</em></p>
}
else if (!statuses.Any())
{
    <p>No statuses found.</p>
}
else
{
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>ID</th>
                <th>Status Context</th>
                <th>Booking ID</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var statusItem in statuses)
            {
                <tr>
                    <td>@statusItem.Id</td>
                    <td>@statusItem.StatusValue</td>
                    <td>@statusItem.Booking.Id</td>
                    <td>
                        <a class="btn btn-sm btn-warning" href="/statuses/edit/@statusItem.Id">Edit</a>
                        <button class="btn btn-sm btn-danger" @onclick="() => DeleteStatus(statusItem.Id)">Delete</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}