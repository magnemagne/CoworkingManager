@page "/areas/create"
@page "/areas/edit/{Id:int}"

<h3>@(IsEditMode ? "Edit Area" : "Create Area")</h3>

@if (area == null)
{
    <p><em>Loading...</em></p>
}
else
{
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger">@errorMessage</div>
    }

    <EditForm Model="area" OnValidSubmit="HandleSubmit">
        <DataAnnotationsValidator />

        <div class="mb-3">
            <label for="name" class="form-label">Name</label>
            <InputText id="name" class="form-control" @bind-Value="area.Name" />
        </div>

        <div class="mb-3">
            <label for="info" class="form-label">Info</label>
            <InputText id="info" class="form-control" @bind-Value="area.Info" />
        </div>

        <button type="submit" class="btn btn-success">Save</button>
        <a class="btn btn-secondary" href="/areas">Cancel</a>
    </EditForm>
}