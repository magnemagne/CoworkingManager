@page "/areas"

<h3>Areas</h3>

<div class="mb-3">
    <a class="btn btn-primary" href="/areas/create">Create New Area</a>
</div>

@if (areas == null)
{
    <p><em>Loading...</em></p>
}
else if (!areas.Any())
{
    <p>No areas found.</p>
}
else
{
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>ID</th>
                <th>Name</th>
                <th>Info</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var area in areas)
            {
                <tr>
                    <td>@area.IdArea</td>
                    <td>@area.Name</td>
                    <td>@area.Info</td>
                    <td>
                        <a class="btn btn-sm btn-warning" href="/areas/edit/@area.IdArea">Edit</a>
                        <button class="btn btn-sm btn-danger" @onclick="() => DeleteArea(area.IdArea)">Delete</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}