@page "/features"

<h3>Features</h3>

<div class="mb-3">
    <a class="btn btn-primary" href="/features/create">Create New Feature</a>
</div>

@if (features == null)
{
    <p><em>Loading...</em></p>
}
else if (!features.Any())
{
    <p>No features found.</p>
}
else
{
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>ID</th>
                <th>Name</th>
                <th>Description</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var feature in features)
            {
                <tr>
                    <td>@feature.IdFeatures</td>
                    <td>@feature.Name</td>
                    <td>@feature.Description</td>
                    <td>
                        <a class="btn btn-sm btn-warning" href="/features/edit/@feature.IdFeatures">Edit</a>
                        <button class="btn btn-sm btn-danger" @onclick="() => DeleteFeature(feature.IdFeatures)">Delete</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}